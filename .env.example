# =============================================================================
# Configuración del Bot de Discord
# =============================================================================
DISCORD_TOKEN=tu_token_del_bot_de_discord_aqui
# ID numérico del canal #admin donde llegarán solicitudes de acceso y alertas de CAPTCHA
ADMIN_CHANNEL_ID=123456789012345678

# =============================================================================
# Configuración de Google Gemini (SDK oficial google-genai)
# =============================================================================
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui
# Modelo multimodal con soporte de esquemas Pydantic sobre API v1beta
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# Configuración de Homelab / noVNC / Scraping
# =============================================================================
# IP local o de Tailscale de tu servidor homelab para generar el link de noVNC en alertas
SERVER_IP=192.168.1.100
NOVNC_PORT=6080

# En Docker con Xvfb + noVNC debe ser "false" para poder ver y resolver CAPTCHAs manualmente
PLAYWRIGHT_HEADLESS=false

# Porcentaje mínimo de caída respecto al precio anterior para disparar alerta de bajada significativa
SIGNIFICANT_DROP_PERCENT=10.0

# Ruta del archivo SQLite
DB_PATH=./data/tracker.db
